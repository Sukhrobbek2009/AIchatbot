# Get from @BotFather in Telegram
BOT_TOKEN=123456:ABC-your-telegram-bot-token
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional
MODEL=gemini-2.5-flash
DB_PATH=data/bot.db
MAX_HISTORY=20
MAX_CONCURRENT=20
# Max requests per user per minute (0 = unlimited)
RATE_LIMIT_PER_MIN=12
# Comma-separated Telegram user IDs. Empty = everyone may use the bot.
ALLOWED_USERS=
